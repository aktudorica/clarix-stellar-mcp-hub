{
  "name": "clarix-stellar-mcp-hub",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @clarix/database generate",
    "db:deploy": "pnpm --filter @clarix/database migrate:deploy",
    "db:seed": "pnpm --filter @clarix/database seed",
    "test": "pnpm --filter @clarix/api test",
    "smoke": "node scripts/smoke.mjs",
    "format": "prettier --write '**/*.{ts,tsx,mjs,json,css,md,yaml,yml}'",
    "format:check": "prettier --check '**/*.{ts,tsx,mjs,json,css,md,yaml,yml}'"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "^24.0.0",
    "prettier": "^3.6.2"
  }
}
