# Local development only. scripts/start.sh generates a random database password.
POSTGRES_PASSWORD=replace_with_a_random_local_password
API_PORT=4310
WEB_PORT=4311
LOG_LEVEL=info

# Generated by scripts/start.sh. Keep stable across restarts.
BETTER_AUTH_SECRET=replace_with_a_random_secret_of_at_least_32_characters

# Optional OpenAI-compatible endpoint. Empty values disable agent requests.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_ENABLE_THINKING=true
LLM_MAX_OUTPUT_TOKENS=16384
LLM_TIMEOUT_MS=180000

# Optional paid Testnet demonstration. Never uses Mainnet.
X402_ENABLED=false
X402_PAY_TO=
X402_PRICE_USDC=0.01
OZ_API_KEY=
