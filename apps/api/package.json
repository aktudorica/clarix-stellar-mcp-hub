{
  "name": "@clarix/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.55",
    "@better-auth/prisma-adapter": "1.7.5",
    "@clarix/application": "workspace:*",
    "@clarix/contracts": "workspace:*",
    "@clarix/database": "workspace:*",
    "@clarix/platform": "workspace:*",
    "@clarix/stellar": "workspace:*",
    "@modelcontextprotocol/express": "2.0.1",
    "@modelcontextprotocol/server": "2.1.0",
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-express": "12.1.0",
    "@x402/core": "2.27.0",
    "@x402/express": "2.27.0",
    "@x402/stellar": "2.27.0",
    "ai": "7.0.113",
    "argon2": "0.45.1",
    "better-auth": "1.7.5",
    "helmet": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.1.0",
    "@nestjs/testing": "12.1.0",
    "@types/express": "^5.0.3",
    "jest": "^30.2.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": [
      "<rootDir>/test/**/*.test.mjs"
    ]
  }
}
